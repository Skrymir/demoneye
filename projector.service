[Unit]
Description=Window projector power over MQTT (IR + HDMI check)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Written for a Pi booted into FPP (user fpp). On the Pi OS card use joshc and
# /home/joshc/demoneye, but don't run it alongside demoneye.service there:
# demoneye already does projector power for Halloween.
User=fpp
WorkingDirectory=/home/fpp/demoneye
# /dev/lirc0 is usually root:video
SupplementaryGroups=video
# MQTT_USER / MQTT_PASS, kept out of config.ini (fine if the file is missing)
EnvironmentFile=-/etc/demoneye.env
ExecStart=/home/fpp/demoneye/venv/bin/python /home/fpp/demoneye/projector_service.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
